@startuml uc3_cancel
title Діаграма послідовності uc3_cancel
hide footbox

actor "Покупець" as P1
boundary "РезервуванняUI" as P2
control "КонтролерСкасування" as P3
participant "DBMgr" as P4
participant "Резервування" as P5
participant "Партія" as P6

P1 -> P2 : обирає резервування(код)
P2 -> P3 : передає запит скасування(телефон, код)
P3 -> P4 : отримує резервування(код)
P4 --> P3 : повертає резервування(резервування)
alt резервування покупця й активне
P3 -> P5 : скасовує резервування()
P5 -> P6 : змінює заблоковану кількість(кількість)
P3 -> P4 : зберігає резервування(партія, резервування)
P3 --> P2 : повертає стан(стан)
else резервування чуже або завершене
P3 --> P2 : повертає причину відмови(причина)
end
P2 --> P1 : показує результат(стан або причина)
@enduml
