@startuml uc11_write_off
title Діаграма послідовності uc11_write_off
hide footbox

actor "Завідувач" as P1
boundary "СкладUI" as P2
control "КонтролерСписання" as P3
participant "DBMgr" as P4
participant "Партія" as P5

P1 -> P2 : обирає партію і причину(препарат, серія, причина, кількість)
P2 -> P3 : передає запит(завідувач, партія, причина)
P3 -> P4 : отримує завідувача(табельний номер)
P4 --> P3 : повертає завідувача(завідувач, аптека)
P3 -> P4 : отримує партію аптеки(аптека, препарат, серія)
P4 --> P3 : повертає партію(партія)
P3 -> P5 : списує вільний залишок(кількість)
create participant "Списання" as P6
P3 -> P6 : створює акт списання(номер, причина, кількість)
P3 -> P4 : зберігає партію і акт(партія, акт)
P3 --> P2 : повертає результат(акт, залишок)
P2 --> P1 : показує партію зі списаним залишком(акт, залишок)
@enduml
