@startuml uc13_sales_report
title Діаграма послідовності uc13_sales_report
hide footbox

actor "Користувач" as P1
boundary "ЗвітUI" as P2
control "КонтролерЗвіту" as P3
participant "DBMgr" as P4
participant "ОбсягЗвіту" as P5

P1 -> P2 : обирає період(початок, кінець, аптека)
P2 -> P3 : передає запит(користувач, період, аптека)
P3 -> P4 : отримує користувача(табельний номер)
P4 --> P3 : повертає користувача(завідувач або директор)
P3 -> P5 : визначає обсяг аптек(користувач, аптека)
P3 -> P4 : отримує чеки за період(початок, кінець)
P4 --> P3 : повертає чеки(чеки)
create participant "ЗвітПродажів" as P6
P3 -> P6 : будує звіт(аптеки, чеки)
P3 --> P2 : повертає звіт(звіт)
P2 --> P1 : показує звіт(рядки, підсумок)
@enduml
