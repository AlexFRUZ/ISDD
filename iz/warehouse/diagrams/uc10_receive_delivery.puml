@startuml uc10_receive_delivery
title Діаграма послідовності uc10_receive_delivery
hide footbox

actor "Завідувач" as P1
boundary "СкладUI" as P2
control "КонтролерПоставки" as P3
participant "DBMgr" as P4
participant "ПеревіркаПоставки" as P5

P1 -> P2 : вводить накладну(номер, постачальник, позиції)
P2 -> P3 : передає запит(завідувач, накладна, позиції)
P3 -> P4 : отримує завідувача(табельний номер)
P4 --> P3 : повертає завідувача(завідувач, аптека)
P3 -> P4 : шукає накладну і постачальника(номер, назва)
P4 --> P3 : повертає результат(порожньо, постачальник)
P3 -> P5 : перевіряє позиції(позиції, дата, аптека)
create participant "Партія" as P6
P3 -> P6 : створює партії(серія, строк, ціни, кількість)
create participant "Поставка" as P7
P3 -> P7 : створює поставку(накладна, постачальник, партії)
P3 -> P4 : зберігає поставку і партії(поставка)
P3 --> P2 : повертає результат(накладна, партії)
P2 --> P1 : показує партії в залишках(накладна, партії)
@enduml
