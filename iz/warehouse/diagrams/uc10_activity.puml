@startuml uc10_activity
title UC10 «Прийняти поставку»
|Завідувач|
start
:Ввести накладну, постачальника й позиції;
|ІС|
if (Накладну вже прийнято?) then (так)
  :Відмова 3a;
  stop
endif
if (Постачальник відомий?) then (ні)
  :Відмова 3b;
  stop
endif
repeat
  :Перевірити позицію;
  if (Препарат є в каталозі?) then (ні)
    :Відмова 4a;
    stop
  elseif (Строк придатності пізніше за сьогодні?) then (ні)
    :Відмова 4b;
    stop
  elseif (Серія нова в аптеці?) then (ні)
    :Відмова 5a;
    stop
  elseif (Строк серії збігається з відомим?) then (ні)
    :Відмова 5b;
    stop
  endif
repeat while (Є ще позиції?) is (так)
:Створити партії й поставку;
:Зберегти транзакцію;
|Завідувач|
:Побачити партії в залишках;
stop
@enduml
