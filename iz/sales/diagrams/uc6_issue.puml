@startuml uc6_issue
title Діаграма послідовності uc6_issue
hide footbox

actor "Фармацевт" as P1
boundary "ПродажUI" as P2
control "КонтролерВидачі" as P3
participant "DBMgr" as P4
participant "ПровайдерРезервувань" as P5
participant "Резервування" as P6
participant "Партія" as P8

P1 -> P2 : вводить код(код резервування)
P2 -> P3 : передає запит видачі(табельний номер, код)
P3 -> P4 : отримує фармацевта(табельний номер)
P4 --> P3 : повертає фармацевта(фармацевт)
P3 -> P5 : шукає резерв(код)
P5 --> P3 : повертає резерв(резервування)
P3 -> P6 : перевіряє стан і строк(поточний час)
create participant "Продаж" as P7
P3 -> P7 : створює чек(фармацевт, покупець)
P3 -> P5 : завершує видачу(резервування, час)
P5 -> P6 : видає резерв(час)
P6 -> P8 : списує заблоковану кількість(кількість)
P3 -> P7 : додає позицію резерву(резервування)
P3 -> P4 : зберігає чек(продаж)
P3 --> P2 : повертає результат(номер, сума)
P2 --> P1 : показує чек(номер, сума)
@enduml
