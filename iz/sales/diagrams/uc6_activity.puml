@startuml uc6_activity
title UC6 «Видати резерв»
|Фармацевт|
start
:Ввести код резервування;
|ІС|
:Знайти фармацевта і резерв;
if (Резерв у цій аптеці?) then (так)
  if (Стан готовий/продовжений?) then (так)
    if (Строк не минув?) then (так)
      if (Є е-рецепт?) then (так)
        :UC9 Перевірити рецепт;
        :Погасити рецепт;
      endif
      :Створити чек;
      :Завершити видачу через ReservationProvider;
      :Списати заблоковану кількість;
      :Зберегти транзакцію;
      |Фармацевт|
      :Передати препарат і чек;
    else (ні)
      |ІС|
      :Відмова 4b;
    endif
  else (ні)
    :Відмова 4a;
  endif
else (ні)
  :Відмова 3a/3b;
endif
stop
@enduml
