@startuml uc7_prescription_sale
title Діаграма послідовності uc7_prescription_sale
hide footbox

actor "Фармацевт" as P1
boundary "ПродажUI" as P2
control "КонтролерПродажуЗаРецептом" as P3
participant "СервісПеревіркиРецептів" as P4
participant "РеєстрРецептів" as P5
participant "Аптека" as P6
participant "Партія" as P8
participant "DBMgr" as P9

P1 -> P2 : вводить рецепт(номер, кількість)
P2 -> P3 : передає запит(фармацевт, номер, кількість)
P3 -> P4 : перевіряє рецепт(номер, дата)
P4 -> P5 : запитує рецепт(номер)
P5 --> P4 : повертає рецепт(рецепт)
P4 --> P3 : повертає чинний рецепт(рецепт)
P3 -> P6 : добирає партію(МНН, кількість, дата)
P3 -> P4 : погашає рецепт(рецепт, кількість)
create participant "Продаж" as P7
P3 -> P7 : створює чек(фармацевт, рецепт)
P3 -> P7 : додає позицію(партія, кількість)
P7 -> P8 : списує кількість(кількість)
P3 -> P9 : зберігає продаж(чек, партія)
P3 --> P2 : повертає результат(номер, сума)
P2 --> P1 : показує чек(номер, сума)
@enduml
