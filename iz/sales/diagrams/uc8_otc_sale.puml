@startuml uc8_otc_sale
title Діаграма послідовності uc8_otc_sale
hide footbox

actor "Фармацевт" as P1
boundary "ПродажUI" as P2
control "КонтролерБезрецептурногоПродажу" as P3
participant "DBMgr" as P4
participant "Препарат" as P5
participant "Аптека" as P6
participant "Партія" as P8

P1 -> P2 : обирає препарат(назва, кількість)
P2 -> P3 : передає запит(фармацевт, назва, кількість)
P3 -> P4 : отримує препарат(назва)
P4 --> P3 : повертає препарат(препарат)
P3 -> P5 : перевіряє тип і ліміт(кількість)
P3 -> P6 : добирає партію FEFO(назва, кількість, дата)
create participant "Продаж" as P7
P3 -> P7 : створює чек(фармацевт)
P3 -> P7 : додає позицію(партія, кількість)
P7 -> P8 : списує кількість(кількість)
P3 -> P4 : зберігає продаж(чек, партія)
P3 --> P2 : повертає результат(номер, сума)
P2 --> P1 : показує чек(номер, сума)
@enduml
