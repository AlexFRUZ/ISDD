@startuml uc7_sale_v2
title Діаграма послідовності uc7_sale_v2
hide footbox

actor "Фармацевт" as P1
boundary "ПродажUI" as P2
control "КонтролерПродажу" as P3
participant "DBMgr" as P4
participant "Реєстр" as P5
participant "ЕлектроннийРецепт" as P6
participant "Аптека" as P7
participant "Партія" as P8
participant "СпосібЦіноутворення" as P11

P1 -> P2 : вводить дані рецепта(номер рецепта, кількість)
P2 -> P3 : передає запит продажу(номер рецепта, кількість)
P3 -> P4 : отримує фармацевта(табельний номер)
P4 --> P3 : повертає фармацевта(фармацевт)
P3 -> P5 : отримує рецепт(номер рецепта)
P5 --> P3 : повертає рецепт(рецепт)
alt рецепт знайдено
P3 -> P6 : визначає причину недійсності(дата)
P3 -> P6 : перевіряє кількість(кількість)
P3 -> P7 : добирає партію(МНН, кількість, дата)
P7 -> P8 : перевіряє придатність(кількість, дата)
P3 -> P5 : погашає рецепт(рецепт, кількість)
P3 -> P6 : отримує спосіб ціноутворення()
create participant "Продаж" as P9
P3 -> P9 : створює продаж(фармацевт, рецепт, спосіб ціноутворення)
P3 -> P9 : додає позицію(партія, кількість)
P9 -> P8 : зменшує залишок(кількість)
create participant "ПозиціяПродажу" as P10
P9 -> P10 : створює позицію(партія, кількість, ціна)
P9 -> P11 : обчислює суму(сума позицій)
P3 -> P4 : зберігає продаж(продаж)
P3 --> P2 : повертає чек(чек)
else рецепт не знайдено
P3 --> P2 : повертає причину відмови(причина)
end
P2 --> P1 : показує результат(чек або причина)
@enduml
