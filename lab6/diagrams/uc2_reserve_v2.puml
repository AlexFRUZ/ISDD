@startuml uc2_reserve_v2
title Діаграма послідовності uc2_reserve_v2
hide footbox

actor "Покупець" as P1
boundary "РезервуванняUI" as P2
control "КонтролерРезервування" as P3
participant "DBMgr" as P4
participant "Аптека" as P5
participant "Партія" as P6

P1 -> P2 : обирає препарат(препарат, аптека, кількість)
P2 -> P3 : передає запит резервування(телефон, препарат, аптека, кількість)
P3 -> P4 : отримує покупця(телефон)
P4 --> P3 : повертає покупця(покупець)
P3 -> P1 : перевіряє ліміт резервувань()
alt ліміт не вичерпано
P3 -> P4 : отримує аптеку(номер аптеки)
P4 --> P3 : повертає аптеку(аптека)
P3 -> P5 : добирає партію(препарат, кількість, дата)
loop для кожної партії препарату
P5 -> P6 : перевіряє придатність(кількість, дата)
end
P3 -> P1 : створює резервування(код, кількість, партія, рецепт)
create participant "Резервування" as P7
P1 -> P7 : створює(код, кількість, партія, рецепт)
P3 -> P7 : підтверджує резервування()
P7 -> P6 : блокує кількість(кількість)
P3 -> P4 : зберігає резервування(резервування)
P3 --> P2 : повертає код резервування(код, строк дії)
else ліміт вичерпано
P3 --> P2 : повертає причину відмови(причина)
end
P2 --> P1 : показує результат(код або причина)
@enduml
