@startuml uc7_sale
title Діаграма послідовності uc7_sale
hide footbox

actor "Фармацевт" as P1
boundary "ПродажUI" as P2
control "КонтролерПродажу" as P3
participant "Реєстр" as P4
participant "ЕлектроннийРецепт" as P5
participant "DBMgr" as P6
participant "Партія" as P8

P1 -> P2 : вводить дані рецепта(номер рецепта, кількість)
P2 -> P3 : передає запит продажу(номер рецепта, кількість)
P3 -> P4 : отримує рецепт(номер рецепта)
P4 --> P3 : повертає рецепт(рецепт)
alt рецепт знайдено і чинний
P3 -> P5 : перевіряє кількість(кількість)
P3 -> P6 : отримує партії(МНН, аптека)
P6 --> P3 : повертає партії(партії)
P3 -> P4 : погашає рецепт(рецепт, кількість)
create participant "Продаж" as P7
P3 -> P7 : створює продаж(фармацевт, рецепт)
P3 -> P7 : додає позицію(партія, кількість)
P7 -> P8 : зменшує залишок(кількість)
create participant "ПозиціяПродажу" as P9
P7 -> P9 : створює позицію(партія, кількість, ціна)
P3 -> P6 : зберігає продаж(продаж, партія)
P3 --> P2 : повертає чек(чек)
else рецепт не знайдено або недійсний
P3 --> P2 : повертає причину відмови(причина)
end
P2 --> P1 : показує результат(чек або причина)
@enduml
